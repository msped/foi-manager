# Copy to .env.local to run the internal staff app locally.
#
#   cp .env.example .env.local
#
# Next.js inlines NEXT_PUBLIC_* values at startup, so restart the dev server
# after changing anything here.

# Django API, called from server components and server actions.
DJANGO_API_URL=http://localhost:8000

# Django API, called from the browser. The axios client in lib/services/django.ts
# picks between the two by host, so keep them in step.
NEXT_PUBLIC_DJANGO_API_URL=http://localhost:8000

# Better Auth session signing key. Generate a fresh one per environment:
#
#   openssl rand -base64 32
#
BETTER_AUTH_SECRET=

# Where this app is served from. BETTER_AUTH_URL is used server-side (and by
# app/api/force-logout to build the redirect); the NEXT_PUBLIC_ copy is what the
# browser client calls. Both point at the same origin.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Branding shown in the header and browser chrome.
#
# Leave these commented out in development. They override the defaults in
# lib/branding.ts, so setting them makes edits to that file look like they do
# nothing. Deploying organisations set them for real.
#
# THEME_COLOUR repoints the Design System's brand colour: the header background,
# the footer's top border, the notification banner, and inverse button text. It
# also sets the mobile browser chrome. Links and page backgrounds are separate
# functional colours and deliberately stay as the Design System defines them.
#
# Must be a hex colour — anything else is ignored and the default is used. Keep
# it dark enough for white text (roughly 4.5:1 against white); the Design System
# uses it both as a background under white text and as text on white buttons.
#
# Quote it. An unquoted `#` starts a comment, so THEME_COLOUR=#192857 parses as
# an empty value and silently falls back to the default.
#
# NEXT_PUBLIC_ORGANISATION_NAME=Your Organisation
# NEXT_PUBLIC_SERVICE_NAME=FOI Manager
# NEXT_PUBLIC_THEME_COLOUR="#1d70b8"

# Microsoft Entra ID single sign-on. Optional — the "Sign in with Microsoft"
# button on /login only renders when the NEXT_PUBLIC_ client ID is set, and
# lib/auth.ts skips the provider entirely unless the ID and secret are both
# present. Email and password sign-in works without any of this.
#
# The client ID appears twice on purpose: the server half configures the OAuth
# provider, the NEXT_PUBLIC_ half only decides whether to show the button.
#
# TENANT_ID defaults to "common" (any Entra tenant); set it to your own tenant
# GUID to restrict sign-in to your organisation.
#
# BETTER_AUTH_MICROSOFT_CLIENT_ID=
# BETTER_AUTH_MICROSOFT_CLIENT_SECRET=
# BETTER_AUTH_MICROSOFT_TENANT_ID=common
# NEXT_PUBLIC_BETTER_AUTH_MICROSOFT_CLIENT_ID=
