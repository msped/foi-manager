# Copy to .env.local to run the public portal locally.
#
#   cp .env.example .env.local
#
# Next.js inlines NEXT_PUBLIC_* values at startup, so restart the dev server
# after changing anything here.

# Django API, called from server components.
DJANGO_API_URL=http://localhost:8000

# Django API, called from the browser. Unused today — every public page fetches
# on the server — but the axios client reads it for the client half of its
# host split, so keep the two in step.
NEXT_PUBLIC_DJANGO_API_URL=http://localhost:8000

# Branding shown in the header, footer and page titles.
#
# Leave these commented out in development. They override the defaults in
# lib/branding.ts, so setting them makes edits to that file look like they do
# nothing. Deploying organisations set them for real.
#
# NEXT_PUBLIC_ORGANISATION_NAME=Your Org
# NEXT_PUBLIC_SERVICE_NAME=Freedom of Information
# NEXT_PUBLIC_THEME_COLOUR=#1d70b8

# Contact details for the accessibility statement and privacy notice.
#
# These have no defaults on purpose — the pages say "we have not published a
# contact address" rather than invent one, so an incomplete deployment is
# visible instead of quietly wrong. Set all three before going live.
#
# The postal address is pipe-separated, one line per part.
#
# NEXT_PUBLIC_FOI_EMAIL=foi@example.gov.uk
# NEXT_PUBLIC_POSTAL_ADDRESS=FOI Team|1 Example Street|Exampleton|AB1 2CD
# NEXT_PUBLIC_DPO_EMAIL=dpo@example.gov.uk
